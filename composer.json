{
    "name": "aimfornan/nan-http",
    "description": "\\NaN\\Http",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "NaN\\": "src/"
        }
    },
    "require": {
        "php": "^8.4",
		"amphp/http": "^2.1",
        "laminas/laminas-diactoros": "^3.8",
		"nette/schema": "^1.3",
        "psr/http-factory": "^1.1"
    },
    "provide": {
        "psr/http-factory-implementation": "^1.0",
		"psr/http-message-implementation": "^1.0"
    },
    "require-dev": {
		"aimfornan/nan-tests": "^0.0.2",
        "guzzlehttp/guzzle": "^7.10"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
	"scripts": {
		"tests": "pest --display-warnings -v"
	}
}
